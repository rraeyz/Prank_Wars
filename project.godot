; Engine configuration file.
config_version=5

[application]

config/name="Prank Wars"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Config="*res://scripts/game_config.gd"
I18n="*res://scripts/i18n.gd"
Sfx="*res://scripts/sfx.gd"
Net="*res://scripts/net.gd"
SteamNet="*res://scripts/steam_net.gd"
Twitch="*res://scripts/twitch.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
rendering_device/fallback_to_opengl3=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
